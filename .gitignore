# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production / build outputs
frontend/dist/
dist/
build/

# Environment files (contain secrets — never commit these)
.env
.env.local
.env.development
.env.production
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# User-uploaded recipe photos (local dev only — not meant to be versioned)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Cache & misc
coverage/
.eslintcache
*.tsbuildinfo
