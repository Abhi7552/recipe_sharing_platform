NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/recipe-platform
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Single origin, or a comma-separated list for multiple deployed frontends
# (e.g. https://app.example.com,https://staging.example.com). Use * only for local dev.
CLIENT_URL=http://localhost:5173

# Set to true only if your network's DNS blocks Node's mongodb+srv:// SRV lookups
# (some Windows/corporate networks do this even though the OS resolver works fine).
FORCE_GOOGLE_DNS=false
